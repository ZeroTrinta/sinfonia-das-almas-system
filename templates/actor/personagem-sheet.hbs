{{!-- Sinfonia das Almas — Ficha de Personagem (DocumentSheetV2) — v0.5 Redesign --}}
<div class="sinfonia-sheet personagem v2-layout">

  {{!-- ═══════ HEADER FAIXA SUPERIOR ═══════ --}}
  <header class="sheet-banner">
    <img class="banner-avatar" src="{{actor.prototypeToken.texture.src}}" data-edit="token-img" title="Clique para mudar a imagem do token (anel dourado)" alt="Token"/>
    <div class="banner-identity">
      <input class="banner-name" type="text" name="name" value="{{actor.name}}" placeholder="Nome do Personagem"/>
      <div class="banner-meta">
        <select name="system.progressao.classe" class="banner-classe">
          <option value="" {{#eq "" system.progressao.classe}}selected{{/eq}}>— Classe —</option>
          <option value="guerreiro" {{#eq "guerreiro" system.progressao.classe}}selected{{/eq}}>Guerreiro</option>
          <option value="gatuno"    {{#eq "gatuno"    system.progressao.classe}}selected{{/eq}}>Gatuno</option>
          <option value="arqueiro"  {{#eq "arqueiro"  system.progressao.classe}}selected{{/eq}}>Arqueiro</option>
          <option value="mago"      {{#eq "mago"      system.progressao.classe}}selected{{/eq}}>Mago</option>
          <option value="sacerdote" {{#eq "sacerdote" system.progressao.classe}}selected{{/eq}}>Sacerdote</option>
        </select>
        <div class="banner-nivel">
          <span class="banner-mini-label">Nível</span>
          <input type="number" name="system.progressao.nivel" value="{{system.progressao.nivel}}" min="1" max="99"/>
        </div>
        <div class="banner-pts">
          <span class="banner-mini-label">Pts Hab.</span>
          <span class="banner-pts-fracao" title="Pontos disponíveis / Total (= nível)">
            <span class="pts-livres">{{habArvore.ptsLivres}}</span><span class="pts-sep">/</span><span class="pts-total">{{habArvore.ptsTotal}}</span>
          </span>
        </div>
      </div>
    </div>

    {{!-- Recursos compactos na faixa --}}
    <div class="banner-resources">
      <div class="res-card pv">
        <div class="res-icon">♥</div>
        <div class="res-content">
          <span class="res-label">PV</span>
          <div class="res-values">
            <input type="number" name="system.recursos.pv.value" value="{{system.recursos.pv.value}}" min="0"/>
            <span class="res-sep">/</span>
            <input type="number" name="system.recursos.pv.max" value="{{system.recursos.pv.max}}" min="0"/>
          </div>
        </div>
      </div>
      <div class="res-card pe">
        <div class="res-icon">✦</div>
        <div class="res-content">
          <span class="res-label">PE</span>
          <div class="res-values">
            <input type="number" name="system.recursos.pe.value" value="{{system.recursos.pe.value}}" min="0"/>
            <span class="res-sep">/</span>
            <input type="number" name="system.recursos.pe.max" value="{{system.recursos.pe.max}}" min="0"/>
          </div>
        </div>
      </div>
      <div class="res-card pi">
        <div class="res-icon">◈</div>
        <div class="res-content">
          <span class="res-label">PI</span>
          <div class="res-values">
            <input type="number" name="system.recursos.pi.value" value="{{system.recursos.pi.value}}" min="0"/>
            <span class="res-sep">/</span>
            <input type="number" name="system.recursos.pi.max" value="{{system.recursos.pi.max}}" min="0"/>
          </div>
        </div>
      </div>
    </div>

    {{!-- Crepúsculo da Morte: indicador que só aparece quando system.alma.crepusculo === true --}}
    {{#if system.alma.morto}}
    <div class="banner-crepusculo morte">
      <div class="crep-banner-icon">☠</div>
      <div class="crep-banner-info">
        <span class="crep-banner-title">MORTO</span>
        <span class="crep-banner-sub">A alma se dissipou. Sem retorno.</span>
      </div>
    </div>
    {{else}}{{#if system.alma.crepusculo}}
    <div class="banner-crepusculo">
      <div class="crep-banner-icon">⚱</div>
      <div class="crep-banner-info">
        <span class="crep-banner-title">Crepúsculo da Morte</span>
        <span class="crep-banner-sub">
          Det: <b>{{system.alma.determinacao}}</b> ·
          {{#if (gt system.alma.determinacao 1)}}
            − 1 Det por turno
          {{else}}
            Teste de Vontade ao iniciar turno
          {{/if}}
        </span>
      </div>
      <button type="button" data-action="rolarTesteCrepusculo" class="btn-crep-rolar" title="Rola o teste de Vontade do Crepúsculo agora">
        <i class="fas fa-dice"></i> Rolar Vontade
      </button>
    </div>
    {{/if}}{{/if}}
  </header>

  {{!-- ═══════ CORPO PRINCIPAL EM 3 COLUNAS ═══════ --}}
  <div class="sheet-main">

    {{!-- ─── COLUNA ESQUERDA (FIXA) ─── --}}
    <aside class="left-rail">
      <div class="rail-portrait">
        <img src="{{actor.img}}" data-edit="img" alt="Retrato"/>
      </div>

      <div class="rail-stats">
        <div class="rail-stat derived" title="Iniciativa (metade do dado AGI)">
          <span class="rail-stat-icon">⚡</span>
          <span class="rail-stat-label">INIT</span>
          <span class="rail-stat-value">{{system.combate.iniciativa}}</span>
        </div>
        <div class="rail-stat derived" title="Defesa Passiva (valor do dado AGI)">
          <span class="rail-stat-icon">🛡</span>
          <span class="rail-stat-label">DEF</span>
          <span class="rail-stat-value">{{system.combate.defesa}}</span>
        </div>
        <div class="rail-stat" title="Deslocamento (metros)">
          <span class="rail-stat-icon">⇄</span>
          <span class="rail-stat-label">DESL</span>
          <div class="rail-stat-input-with-suffix">
            <input type="number" name="system.combate.deslocamento" value="{{system.combate.deslocamento}}"/>
            <span class="rail-stat-suffix">m</span>
          </div>
        </div>
        <div class="rail-stat derived" title="ND Mística (8 + dado MIS)">
          <span class="rail-stat-icon">✦</span>
          <span class="rail-stat-label">ND M.</span>
          <span class="rail-stat-value">{{system.combate.ndMistica}}</span>
        </div>
        <div class="rail-stat estilhacos" title="Estilhaços da Alma">
          <span class="rail-stat-icon">◈</span>
          <span class="rail-stat-label">ESTILH.</span>
          <input type="number" name="system.combate.estilhacos" value="{{system.combate.estilhacos}}" min="0"/>
        </div>
      </div>

      <button type="button" data-action="abrirArvore" class="rail-btn-arvore" title="Abrir Árvore de Habilidades">
        <span class="rail-btn-icon">✶</span>
        <span class="rail-btn-text">Árvore</span>
      </button>

      <button type="button" data-action="descansar" class="rail-btn-secondary" title="Descanso longo: restaura PV, PE e Origens">
        <span class="rail-btn-icon">☾</span>
        <span class="rail-btn-text">Descansar</span>
      </button>
    </aside>

    {{!-- ─── COLUNA CENTRAL ─── --}}
    <main class="center-content">

      {{!-- Atributos no topo --}}
      <section class="atributos-cards">
        {{#each atributosTodos}}
        <div class="atrib-card">
          <span class="atrib-abbr">{{this.abbr}}</span>
          <select name="system.atributos.{{this.key}}" class="atrib-dado">
            <option value="d6"  {{#if this.isD6}}selected{{/if}}>d6</option>
            <option value="d8"  {{#if this.isD8}}selected{{/if}}>d8</option>
            <option value="d10" {{#if this.isD10}}selected{{/if}}>d10</option>
            <option value="d12" {{#if this.isD12}}selected{{/if}}>d12</option>
          </select>
          <span class="atrib-label">{{this.label}}</span>
        </div>
        {{/each}}
      </section>

      {{!-- Conteúdo da tab ativa --}}
      <div class="sheet-body">

        <div class="tab" data-tab="principal">
          {{> "systems/sinfonia-das-almas/templates/actor/tabs/principal.hbs"}}
        </div>

        <div class="tab" data-tab="habilidades">
          {{> "systems/sinfonia-das-almas/templates/actor/tabs/habilidades-arvore.hbs"}}
        </div>

        <div class="tab" data-tab="magias">
          {{> "systems/sinfonia-das-almas/templates/actor/tabs/magias.hbs"}}
        </div>

        <div class="tab" data-tab="inventario">
          {{> "systems/sinfonia-das-almas/templates/actor/tabs/inventario.hbs"}}
        </div>

        <div class="tab" data-tab="alma">
          {{> "systems/sinfonia-das-almas/templates/actor/tabs/alma.hbs"}}
        </div>

        <div class="tab" data-tab="bio">
          {{> "systems/sinfonia-das-almas/templates/actor/tabs/bio.hbs"}}
        </div>

      </div>
    </main>

    {{!-- ─── COLUNA DIREITA: TABS VERTICAIS ─── --}}
    <aside class="right-tabs">
      <a class="vtab" data-tab="principal" title="Perícias e Favoritos">
        <span class="vtab-icon">⚔</span>
        <span class="vtab-label">Principal</span>
      </a>
      <a class="vtab" data-tab="habilidades" title="Árvore de Habilidades">
        <span class="vtab-icon">✶</span>
        <span class="vtab-label">Habilidades</span>
      </a>
      <a class="vtab" data-tab="magias" title="Magias Arcanas e Sagradas">
        <span class="vtab-icon">✦</span>
        <span class="vtab-label">Magias</span>
      </a>
      <a class="vtab" data-tab="inventario" title="Armas, Armaduras e Utilizáveis">
        <span class="vtab-icon">◈</span>
        <span class="vtab-label">Inventário</span>
      </a>
      <a class="vtab" data-tab="alma" title="Alma">
        <span class="vtab-icon">★</span>
        <span class="vtab-label">Alma</span>
      </a>
      <a class="vtab" data-tab="bio" title="Origens e Biografia">
        <span class="vtab-icon">⚭</span>
        <span class="vtab-label">Origens & Bio</span>
      </a>
    </aside>

  </div>
</div>
