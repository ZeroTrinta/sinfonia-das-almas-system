{{!-- TAB HABILIDADES: resumo das habilidades investidas (v0.7.0) --}}
<div class="habilidades-arvore-layout">

  <div class="panel-header arvore-summary">
    <h3 class="panel-title">Habilidades Aprendidas</h3>
    <div class="arvore-pts">
      <span>Investidos: <b>{{habArvore.ptsUsados}}</b></span>
      <span>· Disponíveis: <b>{{habArvore.ptsLivres}}</b></span>
      <span>· Total (Nível): <b>{{habArvore.ptsTotal}}</b></span>
      <button type="button" data-action="abrirArvore" class="btn-link">abrir árvore →</button>
    </div>
  </div>

  {{#if habArvore.semClasse}}
    <p class="items-vazio">
      Nenhuma classe selecionada. Volte para a ficha e escolha uma classe no banner superior.
    </p>
  {{else}}
    {{#if habArvore.investidas.length}}
    <section class="panel habilidade-classe-panel" data-cls="{{habArvore.classe}}">
      <h4 class="classe-titulo" style="color: {{habArvore.classeColor}}; border-color: {{habArvore.classeColor}};">
        {{habArvore.classeLabel}}
      </h4>
      <ul class="hab-arvore-list">
        {{#each habArvore.investidas as |hab|}}
        <li class="hab-arvore-item {{#if hab.passiva}}passiva{{/if}}">
          <span class="hab-bolha" style="background: {{../habArvore.classeColor}}; box-shadow: 0 0 6px {{../habArvore.classeColor}};">{{hab.nh}}</span>
          <div class="hab-info">
            <div class="hab-nome">
              {{hab.label}}
              <span class="hab-nh">NH {{hab.nh}}/{{hab.maxNH}}</span>
            </div>
            {{#if hab.efeitoAtual}}
              <div class="hab-desc"><i class="fas fa-bolt"></i> {{hab.efeitoAtual}}</div>
            {{else}}
              <div class="hab-desc">{{hab.desc}}</div>
            {{/if}}

            {{#if hab.temSublista}}
              {{#if hab.sublistaItens.length}}
              <ul class="hab-sublista">
                {{#each hab.sublistaItens as |sub|}}
                <li class="hab-sub-item">
                  <a class="btn-usar-sub-hab" data-action="usarSubitem" data-hab-id="{{sub.habId}}" data-sub-id="{{sub.id}}" title="Usar {{sub.label}}">
                    <i class="fas fa-play"></i>
                    <span class="sub-item-label">{{sub.label}}</span>
                    {{#if sub.custo}}<span class="sub-item-cost">{{sub.custo}}</span>{{/if}}
                    {{#if sub.acao}}<span class="sub-item-acao">{{sub.acao}}</span>{{/if}}
                  </a>
                </li>
                {{/each}}
              </ul>
              {{/if}}
              {{#if hab.sublistaLivre}}
                <div class="hab-sub-livre">
                  <i class="fas fa-circle-plus"></i>
                  Pode escolher mais <b>{{hab.sublistaLivre}}</b> da lista
                  <button type="button" data-action="abrirArvore" class="btn-link">escolher →</button>
                </div>
              {{/if}}
            {{/if}}
          </div>
        </li>
        {{/each}}
      </ul>
    </section>
    {{else}}
      <p class="items-vazio">
        Nenhuma habilidade investida ainda. Você tem <b>{{habArvore.ptsLivres}}</b> ponto(s) disponíveis.
        <button type="button" data-action="abrirArvore" class="btn-link">Abrir árvore</button>
      </p>
    {{/if}}
  {{/if}}

</div>
