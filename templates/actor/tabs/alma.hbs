{{!-- TAB ALMA --}}
<div class="alma-layout">

  <section class="panel alma-panel">
    <h3 class="panel-title">Eixo da Alma</h3>
    <div class="cabo-de-guerra">

      <div class="alma-lado det-lado">
        <div class="alma-label det-label">
          ★ Determinação <span class="alma-valor">{{system.alma.determinacao}}</span>
        </div>
        <div class="alma-bar-track det-track">
          <div class="alma-bar-fill det-fill" style="width: {{pct system.alma.determinacao 10}}%"></div>
        </div>
        <div class="alma-controls">
          <button type="button" data-action="alternarDet" data-delta="-1" class="det-btn">−</button>
          <input type="number" name="system.alma.determinacao"
            value="{{system.alma.determinacao}}" min="0" max="10" class="alma-num"/>
          <button type="button" data-action="alternarDet" data-delta="1" class="det-btn">+</button>
        </div>
      </div>

      <div class="alma-divider">⟷</div>

      <div class="alma-lado cor-lado">
        <div class="alma-label cor-label">
          ☠ Corrupção <span class="alma-valor">{{system.alma.corrupcao}}</span>
        </div>
        <div class="alma-bar-track cor-track">
          <div class="alma-bar-fill cor-fill" style="width: {{pct system.alma.corrupcao 10}}%"></div>
        </div>
        <div class="alma-controls">
          <span class="cor-info">Automático (10 − Determinação)</span>
        </div>
      </div>

    </div>

    <div class="alma-acoes">
      <button type="button" data-action="corromper" class="btn-corromper">☠ Corromper Alma</button>
      <button type="button" data-action="descansar" class="btn-descansar">☾ Descanso Longo</button>
    </div>
  </section>

  <section class="panel estilhacos-panel">
    <h3 class="panel-title">Estilhaços da Alma</h3>
    <div class="estilhacos-display">
      <span class="estilhacos-valor">{{system.alma.estilhacos}}</span>
      <span class="estilhacos-label">cicatriz{{#if (gt system.alma.estilhacos 1)}}es{{/if}} permanente{{#if (gt system.alma.estilhacos 1)}}s{{/if}}</span>
    </div>
    {{#if (gt system.alma.estilhacos 0)}}
      <p class="estilhacos-aviso">
        Cada Estilhaço reduz o teto máximo da Determinação e adiciona uma mutação
        (benigna ou maligna, definida pelo Mestre).
      </p>
      <button type="button" data-action="resetEstilhacos" class="btn-reset-estilhacos">
        Resetar (GM)
      </button>
    {{/if}}
  </section>

  <section class="panel resist-panel">
    <h3 class="panel-title">Resistências Elementais</h3>
    <p class="origens-hint">Resiste = metade do dano · Vulnerável = dobro · Imune = zero. Aplicado automaticamente ao receber dano do tipo.</p>
    <div class="player-resist-row">
      {{#each resistList}}
      <div class="player-resist {{this.valor}}">
        <span class="player-resist-icon" style="color: {{this.cor}}">{{this.icon}}</span>
        <span class="player-resist-label">{{this.label}}</span>
        <select name="system.resistencias.{{this.key}}" class="player-resist-select">
          <option value=""           {{#eq this.valor ""}}selected{{/eq}}>—</option>
          <option value="resistente" {{#eq this.valor "resistente"}}selected{{/eq}}>Resiste</option>
          <option value="vulneravel" {{#eq this.valor "vulneravel"}}selected{{/eq}}>Vulnerável</option>
          <option value="imune"      {{#eq this.valor "imune"}}selected{{/eq}}>Imune</option>
        </select>
      </div>
      {{/each}}
    </div>
  </section>

  <section class="panel">
    <h3 class="panel-title">Pilar da Alma</h3>
    <input type="text" name="system.alma.pilar"
      value="{{system.alma.pilar}}"
      placeholder="O que sustenta sua vontade de continuar..."/>
  </section>

  <section class="panel origens-panel">
    <h3 class="panel-title">Origens da Alma</h3>
    <p class="origens-hint">Cada Origem reduz a ND em 5 em rolagens conectadas. Uso único por sessão. Falha não gera corrupção.</p>

    <div class="origem-bloco {{#if system.origem.eventoMarcante.usadoNaSessao}}usado{{/if}}">
      <div class="origem-header">
        <span class="origem-tipo">Evento Marcante</span>
        <label class="origem-check">
          <input type="checkbox" name="system.origem.eventoMarcante.usadoNaSessao"
            {{#if system.origem.eventoMarcante.usadoNaSessao}}checked{{/if}}/>
          usado nesta sessão
        </label>
      </div>
      <input type="text" name="system.origem.eventoMarcante.descricao"
        value="{{system.origem.eventoMarcante.descricao}}"
        placeholder="A cicatriz ou troféu que sua alma carrega..."/>
    </div>

    <div class="origem-bloco {{#if system.origem.ocupacao.usadoNaSessao}}usado{{/if}}">
      <div class="origem-header">
        <span class="origem-tipo">Ocupação</span>
        <label class="origem-check">
          <input type="checkbox" name="system.origem.ocupacao.usadoNaSessao"
            {{#if system.origem.ocupacao.usadoNaSessao}}checked{{/if}}/>
          usada nesta sessão
        </label>
      </div>
      <input type="text" name="system.origem.ocupacao.descricao"
        value="{{system.origem.ocupacao.descricao}}"
        placeholder="Como você se empenha (ex: Estudante Curioso)..."/>
    </div>
  </section>

  <div class="qual-def-grid">
    <section class="panel">
      <h3 class="panel-title" style="color:#80e8f8;">Qualidades</h3>
      <textarea name="system.alma.qualidades"
        placeholder="Liste as qualidades do personagem...">{{system.alma.qualidades}}</textarea>
    </section>
    <section class="panel">
      <h3 class="panel-title" style="color:#c87070;">Defeitos</h3>
      <textarea name="system.alma.defeitos"
        placeholder="Liste os defeitos do personagem...">{{system.alma.defeitos}}</textarea>
    </section>
  </div>

</div>
