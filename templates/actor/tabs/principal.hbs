{{!-- TAB PRINCIPAL: Perícias (3 colunas) + Favoritos --}}
<div class="principal-layout">

  {{!-- ═══ PERÍCIAS — TODAS, EM 3 COLUNAS, INLINE ═══ --}}
  <section class="panel pericias-grid-panel">
    <div class="panel-header">
      <h3 class="panel-title">Perícias</h3>
      <span class="panel-hint">Clique no nome para rolar.</span>
    </div>
    <div class="pericias-grid">
      {{#each periciasConfig as |cfg key|}}
      <div class="pericia-row maestria-{{lookup ../system.pericias key}}{{#unless (lookup ../system.pericias key)}} sem-maestria{{/unless}}" data-key="{{key}}">
        <a class="pericia-rolar"
           data-action="rolarPericia"
           data-pericia="{{key}}"
           data-atrib-a="{{cfg.atribA}}"
           data-atrib-b="{{cfg.atribB}}"
           title="Rolar {{cfg.label}}">
          <span class="pericia-nome">{{cfg.label}}</span>
          <span class="pericia-atribs">{{upper cfg.atribA}}+{{upper cfg.atribB}}</span>
        </a>
        <select class="sel-maestria" name="system.pericias.{{key}}" title="Maestria">
          <option value=""           {{#eq "" (lookup ../system.pericias key)}}selected{{/eq}}>—</option>
          <option value="iniciante"  {{#eq "iniciante"  (lookup ../system.pericias key)}}selected{{/eq}}>I (+2)</option>
          <option value="treinado"   {{#eq "treinado"   (lookup ../system.pericias key)}}selected{{/eq}}>T (+4)</option>
          <option value="experiente" {{#eq "experiente" (lookup ../system.pericias key)}}selected{{/eq}}>E (+6)</option>
        </select>
      </div>
      {{/each}}
    </div>
  </section>

  {{!-- ═══ FAVORITOS ═══ --}}
  <section class="panel favoritos-panel">
    <div class="panel-header">
      <h3 class="panel-title">Favoritos</h3>
      <span class="panel-hint">Marque ★ em qualquer item para fixá-lo aqui.</span>
    </div>
    <ul class="items-list favoritos-list">
      {{#each favoritos as |item|}}
      <li class="item favorito-item tipo-{{item.type}}" data-item-id="{{item.id}}">
        <a class="fav-toggle is-fav" data-action="toggleFavorito" data-item-id="{{item.id}}" title="Desfavoritar">
          <i class="fas fa-star"></i>
        </a>
        <img class="item-img" src="{{item.img}}" alt="{{item.name}}"/>
        <div class="item-info">
          <span class="item-nome">{{item.name}}</span>
          <span class="item-sub">
            {{#if (eq item.type "arma")}}
              {{item.system.dano}} {{item.system.tipoDano}}
            {{else if (eq item.type "magia")}}
              {{item.system.circulo}}º · {{item.system.custoPE}} PE
            {{else if (eq item.type "habilidade")}}
              {{#if item.system.custoPE}}{{item.system.custoPE}} PE{{else}}Habilidade{{/if}}
            {{else if (eq item.type "armadura")}}
              +{{item.system.bonusDefesa}} DEF
            {{else if (eq item.type "inventario")}}
              x{{item.system.quantidade}}
            {{/if}}
          </span>
        </div>
        <div class="item-controls">
          {{#if (eq item.type "arma")}}
            <a data-action="atacarArma"    data-item-id="{{item.id}}" title="Atacar" class="icon-atacar"><i class="fas fa-crosshairs"></i></a>
            <a data-action="rolarDanoArma" data-item-id="{{item.id}}" title="Dano" class="icon-dano"><i class="fas fa-dice-d20"></i></a>
          {{else}}
            <a data-action="usarItem" data-item-id="{{item.id}}" title="Usar"><i class="fas fa-bolt"></i></a>
          {{/if}}
          <a data-action="editarItem"  data-item-id="{{item.id}}" title="Editar"><i class="fas fa-edit"></i></a>
        </div>
      </li>
      {{else}}
      <li class="items-vazio">
        Nenhum item favoritado. Marque a estrela ★ em armas, magias, habilidades ou itens para fixá-los aqui.
      </li>
      {{/each}}
    </ul>
  </section>

</div>
