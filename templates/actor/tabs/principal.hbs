{{!-- TAB PRINCIPAL: Perícias (3 colunas) + Favoritos --}}
<div class="principal-layout">

  {{!-- ═══ PERÍCIAS — TODAS, EM 3 COLUNAS, INLINE ═══ --}}
  <section class="panel pericias-grid-panel">
    <div class="panel-header">
      <h3 class="panel-title">Perícias</h3>
      <span class="panel-hint">Clique no nome para rolar.</span>
    </div>
    <div class="pericias-grid">
      {{#each periciasTodas}}
      <div class="pericia-row maestria-{{this.maestria}}{{#if this.isNone}} sem-maestria{{/if}}" data-key="{{this.key}}">
        <a class="pericia-rolar"
           data-action="rolarPericia"
           data-pericia="{{this.key}}"
           data-atrib-a="{{this.atribA}}"
           data-atrib-b="{{this.atribB}}"
           title="Rolar {{this.label}}">
          <span class="pericia-nome">{{this.label}}</span>
          <span class="pericia-atribs">{{upper this.atribA}}+{{upper this.atribB}}</span>
        </a>
        <select class="sel-maestria" name="system.pericias.{{this.key}}" title="Maestria">
          <option value=""           {{#if this.isNone}}selected{{/if}}>—</option>
          <option value="iniciante"  {{#if this.isIniciante}}selected{{/if}}>I (+2)</option>
          <option value="treinado"   {{#if this.isTreinado}}selected{{/if}}>T (+4)</option>
          <option value="experiente" {{#if this.isExperiente}}selected{{/if}}>E (+6)</option>
        </select>
      </div>
      {{/each}}
    </div>
  </section>

  {{!-- ═══ FAVORITOS ═══ --}}
  <section class="panel favoritos-panel">
    <div class="panel-header">
      <h3 class="panel-title">Favoritos</h3>
      <span class="panel-hint">Marque ★ em qualquer item para fixá-lo aqui.</span>
    </div>
    <ul class="items-list favoritos-list">
      {{#each favoritos}}
      <li class="item favorito-item tipo-{{this.type}}" data-item-id="{{this.id}}">
        <a class="fav-toggle is-fav" data-action="toggleFavorito" data-item-id="{{this.id}}" title="Desfavoritar">
          <i class="fas fa-star"></i>
        </a>
        <img class="item-img" src="{{this.img}}" alt="{{this.name}}"/>
        <div class="item-info">
          <span class="item-nome">{{this.name}}</span>
          <span class="item-sub">
            {{#if (eq this.type "arma")}}{{this.system.dano}} {{this.system.tipoDano}}{{/if}}
            {{#if (eq this.type "magia")}}{{this.system.circulo}}º · {{this.system.custoPE}} PE{{/if}}
            {{#if (eq this.type "habilidade")}}{{#if this.system.custoPE}}{{this.system.custoPE}} PE{{else}}Habilidade{{/if}}{{/if}}
            {{#if (eq this.type "armadura")}}+{{this.system.bonusDefesa}} DEF{{/if}}
            {{#if (eq this.type "inventario")}}x{{this.system.quantidade}}{{/if}}
          </span>
        </div>
        <div class="item-controls">
          {{#if (eq this.type "arma")}}
            <a data-action="atacarArma"    data-item-id="{{this.id}}" title="Atacar" class="icon-atacar"><i class="fas fa-crosshairs"></i></a>
            <a data-action="rolarDanoArma" data-item-id="{{this.id}}" title="Dano" class="icon-dano"><i class="fas fa-dice-d20"></i></a>
          {{/if}}
          {{#unless (eq this.type "arma")}}
            <a data-action="usarItem" data-item-id="{{this.id}}" title="Usar"><i class="fas fa-bolt"></i></a>
          {{/unless}}
          <a data-action="editarItem"  data-item-id="{{this.id}}" title="Editar"><i class="fas fa-edit"></i></a>
        </div>
      </li>
      {{else}}
      <li class="items-vazio">
        Nenhum item favoritado. Marque a estrela ★ em armas, magias, habilidades ou itens para fixá-los aqui.
      </li>
      {{/each}}
    </ul>
  </section>

</div>
