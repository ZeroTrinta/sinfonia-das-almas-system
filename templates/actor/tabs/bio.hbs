{{!-- TAB BIOGRAFIA --}}
<div class="bio-layout">
  <section class="panel">
    <h3 class="panel-title">Biografia</h3>
    <div class="editor-container">
      {{editor bioEnriquecida name="system.biografia" button=true editable=isEditable}}
    </div>
  </section>
  <section class="panel">
    <h3 class="panel-title">Notas</h3>
    <div class="editor-container">
      {{editor notasEnriquecidas name="system.notas" button=true editable=isEditable}}
    </div>
  </section>
</div>
