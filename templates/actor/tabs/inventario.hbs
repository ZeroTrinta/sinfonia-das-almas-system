{{!-- TAB INVENTÁRIO --}}
<div class="inventario-layout">
  <div class="panel-header">
    <h3 class="panel-title">Itens Consumíveis</h3>
    <a class="item-create" data-tipo="inventario" title="Adicionar Item"><i class="fas fa-plus"></i></a>
  </div>
  <ul class="items-list inventario-lista">
    {{#each inventario as |item|}}
    <li class="item" data-item-id="{{item.id}}">
      <img class="item-img" src="{{item.img}}" alt="{{item.name}}"/>
      <div class="item-info">
        <span class="item-nome">{{item.name}}</span>
        <span class="item-sub">×{{item.system.quantidade}} · {{item.system.custoPI}} PI</span>
      </div>
      <div class="item-controls">
        <a class="item-usar" title="Usar"><i class="fas fa-hand-paper"></i></a>
        <a class="item-edit" title="Editar"><i class="fas fa-edit"></i></a>
        <a class="item-delete" title="Deletar"><i class="fas fa-trash"></i></a>
      </div>
    </li>
    {{else}}
    <li class="items-vazio">Inventário vazio.</li>
    {{/each}}
  </ul>

  {{!-- Armaduras --}}
  <div class="panel-header" style="margin-top:16px;">
    <h3 class="panel-title">Armaduras</h3>
    <a class="item-create" data-tipo="armadura" title="Adicionar Armadura"><i class="fas fa-plus"></i></a>
  </div>
  <ul class="items-list">
    {{#each armaduras as |item|}}
    <li class="item" data-item-id="{{item.id}}">
      <img class="item-img" src="{{item.img}}" alt="{{item.name}}"/>
      <div class="item-info">
        <span class="item-nome">{{item.name}}</span>
        <span class="item-sub">Defesa +{{item.system.bonusDefesa}}</span>
      </div>
      <div class="item-controls">
        <a class="item-edit" title="Editar"><i class="fas fa-edit"></i></a>
        <a class="item-delete" title="Deletar"><i class="fas fa-trash"></i></a>
      </div>
    </li>
    {{else}}
    <li class="items-vazio">Nenhuma armadura.</li>
    {{/each}}
  </ul>
</div>
